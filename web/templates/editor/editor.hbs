<div class="btn-toolbar">
    <button class="execute btn btn-sm btn-outline-secondary" title="Execute (Ctrl + Enter)"><i class="fa fa-play fa-lg"></i></button>
    <button class="btn btn-sm btn-outline-secondary open" title="Open"><i class="fa fa-folder fa-lg"></i></button>
    <button class="btn btn-sm btn-outline-secondary new" title="New"><i class="fa fa-file fa-lg"></i></button>
    <div class="btn-group">
        <button class="save btn btn-sm btn-outline-secondary" title="Save"><i class="fa fa-save fa-lg"></i></button>
        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="visually-hidden">Toggle Dropdown</span>
        </button>
        <ul class="dropdown-menu">
            <li><a href="#" class="dropdown-item save-as">Save as...</a></li>
        </ul>
    </div>
</div>
<div id="code-wrapper" class="ui-layout-content">
    <textarea name="code" rows="25" cols="100"></textarea>
</div>
